# Redirecionamento para SPA React: qualquer rota desconhecida cai no index.html.
# Arquivos e pastas reais (assets/, imagens, dist-export.zip) são servidos direto.
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
