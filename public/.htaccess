# Redirecionamento para SPA React: qualquer rota desconhecida cai no index.html.
# Arquivos e pastas reais (assets/, imagens, dist-export.zip) são servidos direto.
Options -MultiViews

# ZIPs exportados (dist-export.zip) são baixados com o tipo correto.
<IfModule mod_mime.c>
  AddType application/zip .zip
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # Arquivos .zip (ex.: /download/dist-export.zip) nunca caem no index.html
  RewriteRule \.zip$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
